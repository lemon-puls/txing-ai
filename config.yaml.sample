server:
  # 服务名称
  name: "txing-ai"
  # 服务环境
  profile: "dev"
  # 服务监听地址
  port: 8080
  # 服务版本
  version: "v1.0.0"

# 日志配置
log:
  # 日志级别
  level: "debug"
  # 日志文件名 大小达到 max_size 后会自动分割，保留 max_age 天，最多保留 max_backups 个分割文件
  # 写满后自动新建日志文件命令： txing-ai-2024-10-14T16-12-28.237.log
  file_name: "runtime/log/txing-ai.log"
  # 日志文件大小 单位：MB
  max_size: 4
  # 日志文件保留天数
  max_age: 30
  # 日志文件分割数量上限
  max_backups: 10
# Redis 配置
redis:
  # Redis 地址
  host: localhost
  # Redis 端口
  port: 6379
  # Redis 密码
  password: "123456"
  # 指定数据库
  db: 3

mysql:
  host: localhost
  port: 3306
  username: root
  password: 123456
  database: "txing_ai"
  max_open_conns: 200
  max_idle_conns: 50

cos:
  access_key: ""
  secret_key: ""
  #  地域
  region: ""
  # 存储桶名称
  bucket: ""
  base_url: "https://www.example.com"
  # 预签名 url 过期时间 单位：秒
  sign_expire: 600
  # CDN 加速地址
  cdn_url: "https://www.abc.com"

searchapi:
  endpoint: "https://www.searchapi.io/api/v1/search"
  api_key: "<输入您的 API Key>"
  engine: "baidu"

image_search:
  sougou:
    id: "12345678"
    key: "12345678"
    endpoint: ""

# 本地上传配置 主要用于保存一些临时文件，其他地方上传文件都使用云存储
local_upload:
  dir: "/runtime/temp_files"
  # 文件大小限制 最大 20MB
  max_size: 20971520

# 后台运营助手
ops_agent:
  # 模型名，需在后台「渠道管理」中已配置该模型，否则接口会返回选择渠道失败
  model: "deepseek-v3"
  # 最大工具调用轮次（可选，默认 8）
  max_tool_rounds: 8
  # GitHub API Token（可选），配置后可提升 GitHub 接口限额
  github_token: ""

# LLM Wiki 知识库（docs/llmwiki_design.md §9）
wiki:
  # 总开关：false 时公开问答端点直接下线
  enabled: false
  # agent 引擎实现（D14 插拔）：builtin | hermes | ...（当前仅 builtin）
  agent_impl: "builtin"
  # 问答用模型名，需在后台「渠道管理」中已配置；留空回退默认
  qa_model: "deepseek-v3"
  # ingest 编译用模型名，留空回退 qa_model
  ingest_model: ""
  # 最大工具调用轮次（可选，默认 8）
  max_tool_rounds: 8
  # 单 IP 每小时提问上限（可选，默认 10）
  rate_limit_per_ip_per_hour: 10
  # 全站每日提问总量上限（可选，默认 200）
  daily_quota: 200

# 可插拔可观测性（docs/observability_design.md）
observability:
  # 总开关：false 时所有埋点即时 no-op（热生效，无需重启）
  enabled: true
  # 采样频率：registry 快照间隔
  sample_interval: 15s
  # 环形缓冲槽粒度（重启生效）
  slot_interval: 1m
  # 内存保留时长（<=48h，重启清零；长期运营统计走 MySQL 业务表聚合）
  retention: 24h
  # 时序数上限（基数防御，超出丢弃新序列并告警）
  max_series: 2000
  # 外部抓取模式：暴露标准 /metrics 供 Prometheus/VictoriaMetrics 抓取
  external:
    # 路由注册在启动时，改动需重启生效
    enabled: false
    # 非空时 /metrics 校验 Authorization: Bearer <token>
    bearer_token: ""
